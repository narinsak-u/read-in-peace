# Intentionally unconfigured. Operator must set every production credential and URL.
NODE_ENV=production
# DATABASE_URL=<operator-provided production database>
# BETTER_AUTH_URL=<operator-owned Reading backend origin>
# FRONTEND_URL=<operator-owned Reading frontend origin>
# CORS_ORIGINS=<operator-owned Reading frontend origin>
# AUTH_SECRET=<operator-provided secret>
# STRIPE_SECRET_KEY=<operator-provided payment secret>
# STRIPE_WEBHOOK_SECRET=<operator-provided webhook secret>
# CENTRAL_IDENTITY_ISSUER=<operator-owned Central Identity issuer>
# CENTRAL_IDENTITY_CLIENT_ID=<provisioned production client ID>
# CENTRAL_IDENTITY_CLIENT_SECRET=<provisioned production client secret>
# Recovery-only callback URIs and provider credentials. Provision separately; never expose client secrets to the frontend.
# READING_RECOVERY_OIDC_REDIRECT_URI=https://<operator-owned backend origin>/api/identity-recovery/callback
# READING_RECOVERY_PROVIDER_REDIRECT_URI=https://<operator-owned backend origin>/api/identity-recovery/provider/callback
# READING_RECOVERY_GOOGLE_CLIENT_ID=<migration-only Google OAuth client ID>
# READING_RECOVERY_GOOGLE_CLIENT_SECRET=<migration-only Google OAuth client secret>
# READING_RECOVERY_GITHUB_CLIENT_ID=<migration-only GitHub OAuth client ID>
# READING_RECOVERY_GITHUB_CLIENT_SECRET=<migration-only GitHub OAuth client secret>
