NODE_ENV=development
DATABASE_URL=postgres://readinpeace:readinpeace@localhost:5432/readinpeace
BETTER_AUTH_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
PORT=3000
LOG_LEVEL=info
AUTH_SECRET=<generate-a-local-secret-at-least-16-characters>
STRIPE_SECRET_KEY=<local-test-key>
STRIPE_WEBHOOK_SECRET=<local-test-webhook-secret>
CENTRAL_IDENTITY_ISSUER=https://auth.localhost:8080/api/auth
CENTRAL_IDENTITY_CLIENT_ID=<provision-locally>
CENTRAL_IDENTITY_CLIENT_SECRET=<provision-locally>
READING_RECOVERY_OIDC_REDIRECT_URI=http://localhost:3001/api/identity-recovery/callback
READING_RECOVERY_PROVIDER_REDIRECT_URI=http://localhost:3001/api/identity-recovery/provider/callback
