# Local-only production-mode config; encrypt with this package's ignored .env.test-production.keys.
NODE_ENV=production
TEST_PRODUCTION=true
DATABASE_URL=postgres://postgres:postgres@localhost:5433/read_in_peace
BETTER_AUTH_URL=https://reading-test.localhost:8081
FRONTEND_URL=https://reading-test.localhost:8081
CORS_ORIGINS=https://reading-test.localhost:8081
PORT=3100
LOG_LEVEL=info
# Supply a unique local auth secret, Stripe test credentials, and an operator-provisioned test Central Identity client.
AUTH_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CENTRAL_IDENTITY_ISSUER=https://auth-test.localhost:8081/api/auth
CENTRAL_IDENTITY_CLIENT_ID=
CENTRAL_IDENTITY_CLIENT_SECRET=
READING_RECOVERY_OIDC_REDIRECT_URI=https://reading-test.localhost:8081/api/identity-recovery/callback
READING_RECOVERY_PROVIDER_REDIRECT_URI=https://reading-test.localhost:8081/api/identity-recovery/provider/callback
# Temporary provider OAuth clients; register the provider callback above and never reuse login credentials.
READING_RECOVERY_GOOGLE_CLIENT_ID=
READING_RECOVERY_GOOGLE_CLIENT_SECRET=
READING_RECOVERY_GITHUB_CLIENT_ID=
READING_RECOVERY_GITHUB_CLIENT_SECRET=
