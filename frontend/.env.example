# Backend API URL (Nuxt proxy forwards /api/* here)
NUXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Site URL (used by social share module)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Public provider page for the separately named central sign-out action.
NUXT_PUBLIC_CENTRAL_IDENTITY_URL=https://auth.127.0.0.1.nip.io
