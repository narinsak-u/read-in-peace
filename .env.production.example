# Copy to .env.production and set verified operator-owned values.
COMPOSE_PROJECT_NAME=reading-production
READING_DB_VOLUME=verified-existing-reading-volume
READING_POSTGRES_DB=reading
READING_POSTGRES_USER=reading
READING_POSTGRES_PASSWORD=replace-with-existing-database-password
READING_DATABASE_URL=postgres://reading:replace-with-existing-database-password@db:5432/reading
READING_AUTH_SECRET=replace-with-existing-secret
READING_STRIPE_SECRET_KEY=replace-with-existing-stripe-secret
READING_STRIPE_WEBHOOK_SECRET=replace-with-existing-webhook-secret
READING_FRONTEND_URL=https://reading.example.com
READING_BACKEND_URL=https://reading.example.com
READING_FRONTEND_PORT=3100
READING_BACKEND_PORT=4000
CENTRAL_IDENTITY_ISSUER=https://identity.example.com/api/auth
NUXT_PUBLIC_CENTRAL_IDENTITY_URL=https://identity.example.com
CENTRAL_IDENTITY_CLIENT_ID=replace-with-production-client-id
CENTRAL_IDENTITY_CLIENT_SECRET=replace-with-production-client-secret
